# 복사해서 .env.local 로 저장하세요. 이 파일에는 진짜 비밀번호를 적지 않습니다.
# 변수가 하나도 없어도 공개 페이지는 기본 글로 열립니다.

# --- 관리자 로그인 (/admin) ---
# 두 값을 모두 넣어야 로그인됩니다.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Vercel(https)에서는 쿠키를 자동으로 안전하게 보냅니다.
# 로컬 http 에서는 비워 두세요.
# ADMIN_COOKIE_SECURE=true

# --- 콘텐츠 저장 ---
# 비우면: 내 컴퓨터에서는 .data/site-content.json 에 저장합니다.
#         Vercel 에서는 기본 글만 보여주고 저장은 되지 않습니다.
# file | supabase | seed 중에서 강제로 고르려면 아래를 사용합니다.
# CONTENT_STORE=

# Supabase 를 쓸 때. 서비스 롤 키는 서버 전용입니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 선택. 검색 결과에 쓸 사이트 주소. 없어도 됩니다.
# NEXT_PUBLIC_SITE_URL=https://kld-home-page.vercel.app
